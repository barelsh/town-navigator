{
  "name": "town-navigator",
  "version": "0.1.0",
  "description": "Demo web app for navigating a town in 3D, generated from real GeoJSON data.",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently --names server,client --prefix-colors blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "normalize": "node data/scripts/normalize_coordinates.js",
    "tile": "node data/scripts/tile_town.js",
    "test": "node --test client/src"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "osmtogeojson": "3.0.0-beta.5",
    "typescript": "^7.0.2"
  }
}
